# Backend-specific overrides. Most env vars come from the workspace-level .env.

# .NET configuration binding reads these as ConnectionStrings:Default and ASPNETCORE_*
ConnectionStrings__Default=Server=${MYSQL_HOST};Port=${MYSQL_PORT};Database=${MYSQL_DATABASE};Uid=${MYSQL_USER};Pwd=${MYSQL_PASSWORD};
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
