{
  "$schema": "https://swarmagents.dev/schema/workspace.json",
  "name": "swarm-agents-example",
  "version": "0.2.0",
  "github": {
    "owner": "PoliedroSoftware",
    "repo": "swarm-agents-example"
  },
  "contracts": [
    {
      "name": "main-api",
      "type": "openapi",
      "producer": "backend",
      "path": "contracts/api.openapi.yaml",
      "snapshot": "contracts/api.openapi.snapshot.yaml",
      "consumers": ["frontend"],
      "breakingChangeBehavior": "pause-and-ask"
    }
  ],
  "projects": [
    {
      "name": "backend",
      "kind": "backend",
      "path": "projects/backend",
      "stack": "dotnet",
      "framework": "aspnetcore",
      "profile": "dotnet-clean-architecture",
      "produces": ["main-api"],
      "consumes": [],
      "agents": [
        "planner",
        "orchestrator",
        "architect-reviewer",
        "code-writer",
        "test-writer",
        "db-migrator",
        "postman-curator",
        "sonar-analyst",
        "jmeter-runner",
        "qa-tester",
        "security-reviewer",
        "redis-cache-manager",
        "final-reviewer"
      ],
      "mcps": ["github", "postman", "mysql", "filesystem"],
      "infrastructure": {
        "database": "mysql",
        "cache": "redis"
      }
    },
    {
      "name": "frontend",
      "kind": "frontend",
      "path": "projects/frontend",
      "stack": "angular",
      "framework": "angular",
      "profile": "angular-standard",
      "produces": [],
      "consumes": ["main-api"],
      "agents": [
        "planner",
        "orchestrator",
        "component-reviewer",
        "code-writer",
        "test-writer",
        "a11y-auditor",
        "perf-auditor",
        "e2e-writer",
        "qa-tester",
        "security-reviewer",
        "final-reviewer"
      ],
      "mcps": ["github", "filesystem"]
    }
  ],
  "profiles": {
    "dotnet-clean-architecture": {
      "description": "ASP.NET Core backend using Clean Architecture, CQRS, MediatR, FluentValidation, EF Core, MySQL and Redis.",
      "defaultAgents": ["planner", "orchestrator", "code-writer", "test-writer", "architect-reviewer", "security-reviewer", "final-reviewer"]
    },
    "angular-standard": {
      "description": "Angular frontend that consumes named OpenAPI contracts and keeps generated API clients separated from handwritten UI code.",
      "defaultAgents": ["planner", "orchestrator", "code-writer", "test-writer", "component-reviewer", "a11y-auditor", "final-reviewer"]
    },
    "maui-mvvm": {
      "description": "Optional .NET MAUI mobile consumer profile using MVVM, DI through MauiProgram.cs and generated C# clients from OpenAPI.",
      "defaultAgents": ["planner", "orchestrator", "code-writer", "test-writer", "ui-reviewer", "security-reviewer", "final-reviewer"]
    }
  },
  "orchestrationRules": {
    "planFirst": true,
    "codeWritersRequireAssignedTask": true,
    "whenProducerChangesContract": [
      "contract-guardian",
      "cross-impact-analyzer",
      "affected-consumer-planners"
    ],
    "consumerResolution": "by-named-contract",
    "requireApprovalFor": [
      "breaking-contract-change",
      "database-migration",
      "security-sensitive-change"
    ]
  },
  "policies": {
    "breakingChangeBehavior": "pause-and-ask",
    "approvalGate": "risky-only",
    "memoryWriters": ["planner", "final-reviewer", "security-reviewer"],
    "postmanCuratorTrigger": "github.pr.merged",
    "sonarTrigger": "implementation.complete"
  },
  "githubApp": {
    "enabled": false
  }
}
